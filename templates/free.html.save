<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIGN — Космическая кузница агентов</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0a0a1a;
            color: #e8e8f0;
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
            padding: 20px;
            background-image: 
                radial-gradient(ellipse at 20% 50%, #1a1a3e 0%, #0a0a1a 70%),
                radial-gradient(ellipse at 80% 20%, #1a0a2e 0%, transparent 50%);
        }
        .container { max-width: 1200px; margin: 0 auto; }

        .stars {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            background: transparent;
        }
        .star {
            position: absolute;
            width: 2px;
            height: 2px;
            background: #fff;
            border-radius: 50%;
            opacity: 0.6;
            animation: twinkle 4s infinite alternate;
        }
        .star:nth-child(1) { top: 10%; left: 20%; animation-delay: 0s; }
        .star:nth-child(2) { top: 30%; left: 70%; animation-delay: 1s; }
ЫВЫ        .star:nth-child(3) { top: 60%; left: 10%; animation-delay: 2s; }
        .star:nth-child(4) { top: 80%; left: 80%; animation-delay: 3s; }
        .star:nth-child(5) { top: 40%; left: 50%; animation-delay: 0.5s; }
        .star:nth-child(6) { top: 90%; left: 30%; animation-delay: 1.5s; }
        .star:nth-child(7) { top: 15%; left: 90%; animation-delay: 2.5s; }
        .star:nth-child(8) { top: 70%; left: 60%; animation-delay: 3.5s; }
        @keyframes twinkle {
            0% { opacity: 0.2; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1.2); }
        }

        .sparks {
            position: fixed;
             }
        .spark {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: radial-gradient(circle, #00d4ff, #a855f7);
            box-shadow: 0 0 20px #00d4ff66, 0 0 60px #a855f744;
            opacity: 0;
            animation: sparkFloat 10s infinite;
        }
        .spark:nth-child(1) { left: 10%; animation-delay: 0s; }
        .spark:nth-child(2) { left: 30%; animation-delay: 2s; }
        .spark:nth-child(3) { left: 60%; animation-delay: 4s; }
        .spark:nth-child(4) { left: 80%; animation-delay: 6s; }
        .spark:nth-child(5) { left: 50%; animation-delay: 1s; }
        .spark:nth-child(6) { left: 20%; animation-delay: 3s; }
        .spark:nth-child(7) { left: 70%; animation-delay: 5s; }
        .spark:nth-child(8) { left: 90%; animation-delay: 7s; }
        @keyframes sparkFloat {
            0% { transform: translateY(100vh) scale(0.5) rotate(0deg); opacity: 0; }
            20% { opacity: 1; }
            80% { opacity: 1; }
            100% { transform: translateY(-10vh) scale(1.5) rotate(720deg); opacity: 0; }
        }

        .header {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 30px 0 20px;
            border-bottom: 2px solid #00d4ff44;
        }
        .logo {
            font-size: 3rem;
            font-weight: 300;
            letter-spacing: 6px;
            text-shadow: 0 0 30px #00d4ff33;
        }
        .logo span { color: #00d4ff; font-weight: 600; }
        .subtitle {
            color: #a855f7;
            font-size: 1.2rem;
            letter-spacing: 3px;
             box-shadow: 0 0 30px #00d4ff22        }
        .info-block .icon { font-size: 2rem; display: block; margin-bottom: 6px; }
        .info-block h3 { color: #00d4ff; font-size: 1rem; margin-bo            z-index: 1;
        }
        .genre-grid {
           display: grid;
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 10px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }
        .genre-card {
            background: rgba(18, 18, 40, 0.7);
            border: 1px solid #2a2a5e;
            border-radius: 14px;
            padding: 10px 4px;
            text-align: center;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.25s;
            color: #b0b0d0;
            user-select: none;
        }
        .genre-card:hover { border-color: #00d4ff66; transform: translateY(-2px); }
        .genre-card.selected { border-color: #00d4ff; color: #00d4ff; box-shadow: 0 0 20px #00d4ff22; }

        .canvas-wrapper {
            display: flex;
            justify-content: center;
            margin: 20px 0;
            position: relative;
            z-index: 1;
        }
        #signCanvas {
            background: #0d0d20;
            border: 2px solid #00d4ff44;
            border-radius: 24px;
            width: 100%;
            max-width: 420px;
            aspect-ratio: 1/1;
            cursor: crosshair;
            touch-action: none;
            transition: border-color 0.3s;
        }
        #signCanvas:hover { border-color: #00d4ff; }
        .canvas-hint {
            text-align: center;
            font-size: 0.8rem;
            color: #666688;
            margin-bottom: 16px;
            position: relative;
            z-index: 1;
        }

        .input-group {
            max-width: 420px;
            margin: 0 auto 16px;
            position: relative;
            z-index: 1;
        }
        #ownerName {
            width: 100%;
            padding: 14px 20px;
            border-radius: 60px;
            border: 1px solid #2a2a5e;
            background: rgba(18, 18, 40, 0.8);
            color: #e8e8f0;
            font-size: 1rem;
            outline: none;
            transition: border 0.3s;
        }
        #ownerName:focus { border-color: #00d4ff; }
        #ownerName::placeholder { color: #666688; }

        .btn-primary {
            display: block;
            width: 100%;
            max-width: 420px;
            margin: 0 auto 12px;
            padding: 16px;
            border-radius: 60px;
            border: none;
            font-size: 1.1rem;
            font-weight: 700;
            background: linear-gradient(135deg, #00d4ff, #a855f7);
            color: #0a0a1a;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 1px;
            position: relative;
            z-index: 1;
            box-shadow: 0 0 30px #00d4ff33;
        }
        .btn-primary:hover { transform: scale(1.02); box-shadow: 0 0 60px #00d4ff66; }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

        #result {
            background: rgba(13, 13, 32, 0.9);
            border: 1px solid #00d4ff44;
            border-radius: 20px;
            padding: 24px;
            margin-top: 24px;
            display: none;
            max-height: 550px;
            overflow-y: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            line-height: 1.6;
            white-space: pre-wrap;
            word-break: break-word;
            position: relative;
            z-index: 1;
        }
        #result .label { color: #00d4ff; font-weight: 600; display: block; margin-bottom: 12px; }

        .payment-block {
            display: none;
            margin-top: 30px;
            padding: 20px;
            background: rgba(18, 18, 40, 0.9);
            border: 2px solid #00d4ff66;
            border-radius: 24px;
            text-align: center;
            position: relative;
            z-index: 1;
        }
        .payment-block.active { display: block; }
        .payment-block h3 { color: #00d4ff; font-size: 1.4rem; margin-bottom: 16px; }
        .payment-options {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .payment-option {
            background: rgba(26, 26, 60, 0.8);
            border: 1px solid #2a2a5e;
            border-radius: 16px;
            padding: 16px 24px;
            cursor: pointer;
            transition: all 0.3s;
            min-width: 140px;
        }
        .payment-option:hover { border-color: #00d4ff; transform: scale(1.05); }
        .payment-option .icon { font-size: 2rem; display: block; }
        .payment-option .label { font-size: 1rem; color: #e8e8f0; margin-top: 6px; }
        .reset-btn {
            display: inline-block;
            margin-top: 12px;
            padding: 6px 16px;
            border-radius: 60px;
            background: transparent;
            border: 1px solid #555577;
            color: #8888aa;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s;
        }
        .reset-btn:hover { border-color: #00d4ff; color: #00d4ff; }

        .footer {
            text-align: center;
            padding: 30px 0 10px;
            border-top: 1px solid #1a1a3e;
            margin-top: 40px;
            color: #555577;
            font-size: 0.8rem;
            position: relative;
            z-index: 1;
        }
        .footer a { color: #00d4ff88; text-decoration: none; }
        .footer a:hover { color: #00d4ff; }

        @media (max-width: 600px) {
            .genre-grid { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
            .logo { font-size: 2rem; }
            .payment-options { flex-direction: column; align-items: center; }
        }
    </style>
</head>
<body>
    <div class="stars">
        <div class="star"></div><div class="star"></div>
        <div class="star"></div><div class="star"></div>
        <div class="star"></div><div class="star"></div>
        <div class="star"></div><div class="star"></div>
    </div>
    <div class="sparks">
        <div class="spark"></div><div class="spark"></div>
        <div class="spark"></div><div class="spark"></div>
        <div class="spark"></div><div class="spark"></div>
        <div class="spark"></div><div class="spark"></div>
    </div>

    <div class="container">
        <header class="header">
            <div class="logo">SIGN <span>PAID</span></div>
            <div class="subtitle">Космическая кузница агентов</div>
            <div class="tagline">🚀 Сгенерируй своего агента в нашей кузнице</div>
        </header>

        <div class="info-grid">
            <div class="info-block">
                <span class="icon">🧠</span>
                <h3>Что такое цифровой помощник?</h3>
                <p>ИИ, который понимает твой стиль и работает 24/7.</p>
            </div>
            <div class="info-block">
                <span class="icon">🧬</span>
                <h3>Что такое AIID?</h3>
                <p>Цифровой паспорт твоего агента: ДНК, характер, промпт.</p>
            </div>
            <div class="info-block">
                <span class="icon">📖</span>
                <h3>Как это работает?</h3>
                <p>Выбери жанр → нарисуй росчерк → получи AIID → копируй промпт.</p>
            </div>
            <div class="info-block">
                <span class="icon">📐</span>
                <h3>Откуда берётся ДНК?</h3>
                <p>Анализируем 7 признаков росчерка → 7 критериев ДНК.</p>
            </div>
        </div>

        <div class="section-title">Выбери жанр (все 50 активны)</div>
        <div class="genre-grid" id="genreGrid"></div>

        <div class="input-group">
            <input type="text" id="ownerName" placeholder="Ваше имя (необязательно)">
        </div>
        <div class="canvas-wrapper">
            <canvas id="signCanvas" width="500" height="500"></canvas>
        </div>
        <div class="canvas-hint">✍️ Нарисуйте росчерк — это будет ДНК вашего AIID</div>

        <button class="btn-primary" id="createBtn">⚡ Сгенерировать своего агента</button>

        <div id="result">
            <span class="label">🧬 AIID-паспорт</span>
            <div id="resultContent"></div>
        </div>

        <div class="payment-block" id="paymentBlock">
            <h3>💰 Продолжить ковку</h3>
            <p style="color:#8888bb; margin-bottom:16px;">Вы использовали тестовую попытку. Для неограниченной генерации выберите способ оплаты:</p>
            <div class="payment-options">
                <div class="payment-option" id="payRub">
                    <span class="icon">💳</span>
                    <span class="label">Оплатить картой (рубли)</span>
                    <span style="font-size:0.8rem; color:#8888bb;">25$ ≈ 2200 ₽</span>
                </div>
                <div class="payment-option" id="payUsdt">
                    <span class="icon">₿</span>
                    <span class="label">Оплатить USDT</span>
                    <span style="font-size:0.8rem; color:#8888bb;">25 USDT (TRC-20)</span>
                </div>
            </div>
            <div style="margin-top:16px; font-size:0.8rem; color:#555577;">
                <p>Реквизиты для оплаты (заглушка):</p>
                <p>Карта: 1234 5678 9012 3456 · Кошелёк: TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</p>
            </div>
            <button class="reset-btn" id="resetTrialBtn">Сбросить попытку (для теста)</button>
        </div>

        <div class="footer">
            SIGN · <a href="https://sign.space" target="_blank">Вселенная Эйдос</a>
        </div>
    </div>

    <script>
        (function() {
            const ALL_GENRES = [
                'Спорт', 'Крипта', 'Творчество', 'Бизнес', 'Дом / Ремонт',
                'Образование', 'Соцсети', 'Психология', 'Путешествия', 'Фото / Видео',
                'Авто', 'IT / Программирование', 'Юриспруденция', 'Финансы', 'Маркетинг',
                'Дизайн / UI/UX', 'Здоровье / Медицина', 'Кулинария', 'Игры / Гейминг',
                'Фитнес / ЗОЖ', 'Языки / Лингвистика', 'Наука / Исследования', 'HR / Карьера',
                'Психическое здоровье', 'Недвижимость', 'Логистика / Снабжение', 'Ивенты / Мероприятия',
                'Мода / Стиль', 'Экология / Устойчивое развитие', 'Автоматизация бизнеса',
                'Крипто-юриспруденция', 'Информационная безопасность', 'Робототехника / DIY',
                'Искусственный интеллект', 'Кино / Видеопродакшн', 'Астрономия / Космос',
                'История / Археология', 'Философия / Этика', 'Инженерия / Конструирование',
                'Квантовые технологии', 'Биотехнологии / Генетика', 'Нутрициология / Питание',
                'Спортивная медицина', 'Сон / Биоритмы', 'Поэзия / Литература',
                'Театр / Драматургия', 'Анимация / Мультипликация',
                'Социальное предпринимательство', 'Устойчивое развитие / ESG', 'Психология личности'
            ];

            const TRIAL_KEY = 'sign_paid_trial_used';
            let trialUsed = localStorage.getItem(TRIAL_KEY) === 'true';
            let selectedGenre = ALL_GENRES[0];
            let signaturePoints = [];
            let isDrawing = false;

            const grid = document.getElementById('genreGrid');
            const canvas = document.getElementById('signCanvas');
            const ctx = canvas.getContext('2d');
            const ownerInput = document.getElementById('ownerName');
            const createBtn = document.getElementById('createBtn');
            const resultDiv = document.getElementById('result');
            const resultContent = document.getElementById('resultContent');
            const paymentBlock = document.getElementById('paymentBlock');
            const resetBtn = document.getElementById('resetTrialBtn');

            if (trialUsed) {
                paymentBlock.classList.add('active');
            }

            resetBtn.addEventListener('click', function() {
                localStorage.removeItem(TRIAL_KEY);
                trialUsed = false;
                paymentBlock.classList.remove('active');
                alert('Тестовая попытка сброшена. Обновите страницу.');
                location.reload();
            });

            ALL_GENRES.forEach(g => {
                const card = document.createElement('div');
                card.className = 'genre-card';
                if (g === selectedGenre) card.classList.add('selected');
                card.dataset.genre = g;
                card.textContent = g;
                card.addEventListener('click', function() {
                    document.querySelectorAll('.genre-card').forEach(c => c.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedGenre = this.dataset.genre;
                });
                grid.appendChild(card);
            });

            ctx.strokeStyle = '#00d4ff';
            ctx.lineWidth = 4;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.shadowColor = '#00d4ff66';
            ctx.shadowBlur = 12;

            function getCanvasCoords(e) {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                let clientX, clientY;
                if (e.touches) {
                    clientX = e.touches[0].clientX;
                    clientY = e.touches[0].clientY;
                    e.preventDefault();
                } else {
                    clientX = e.clientX;
                    clientY = e.clientY;
                }
                return {
                    x: (clientX - rect.left) * scaleX,
                    y: (clientY - rect.top) * scaleY
                };
            }

            function startDrawing(e) {
                e.preventDefault();
                isDrawing = true;
                const { x, y } = getCanvasCoords(e);
                ctx.beginPath();
                ctx.moveTo(x, y);
                ctx.lineTo(x + 0.5, y + 0.5);
                ctx.stroke();
                signaturePoints = [{ x, y, time: Date.now() }];
            }

            function drawMove(e) {
                e.preventDefault();
                if (!isDrawing) return;
                const { x, y } = getCanvasCoords(e);
                ctx.lineTo(x, y);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(x, y);
                signaturePoints.push({ x, y, time: Date.now() });
            }

            function endDrawing(e) {
                e.preventDefault();
                if (isDrawing) {
                    isDrawing = false;
                    if (signaturePoints.length < 5) {
                        alert('✍️ Росчерк слишком короткий.');
                    }
                }
            }

            canvas.addEventListener('mousedown', startDrawing);
            canvas.addEventListener('mousemove', drawMove);
            canvas.addEventListener('mouseup', endDrawing);
            canvas.addEventListener('mouseleave', endDrawing);
            canvas.addEventListener('touchstart', startDrawing, { passive: false });
            canvas.addEventListener('touchmove', drawMove, { passive: false });
            canvas.addEventListener('touchend', endDrawing, { passive: false });

            canvas.addEventListener('dblclick', function() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                signaturePoints = [];
            });

            createBtn.addEventListener('click', async function() {
                const btn = this;
                btn.disabled = true;
                btn.textContent = '⏳ Генерация...';

                const name = ownerInput.value.trim() || 'Агент';

                if (signaturePoints.length < 5) {
                    alert('✍️ Нарисуйте росчерк.');
                    btn.disabled = false;
                    btn.textContent = '⚡ Сгенерировать своего агента';
                    return;
                }

                if (trialUsed) {
                    alert('Тестовая попытка использована. Оплатите доступ для продолжения.');
                    paymentBlock.classList.add('active');
                    btn.disabled = false;
                    btn.textContent = '⚡ Сгенерировать своего агента';
                    return;
                }

                resultDiv.style.display = 'block';
                resultContent.textContent = '⏳ Обработка росчерка...';

                try {
                    const response = await fetch('/api/generate_paid', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            genre: selectedGenre,
                            specialization: '',
                            owner_name: name,
                            points: signaturePoints
                        })
                    });
                    const data = await response.json();
                    if (data.status === 'ok') {
                        resultContent.textContent = data.aiid_content;
                        localStorage.setItem(TRIAL_KEY, 'true');
                        trialUsed = true;
                        paymentBlock.classList.add('active');
                    } else {
                        resultContent.textContent = '❌ Ошибка: ' + data.message;
                    }
                } catch (e) {
                    resultContent.textContent = '❌ Ошибка соединения.';
                }

                btn.disabled = false;
                btn.textContent = '⚡ Сгенерировать своего агента';
            });

            document.getElementById('payRub').addEventListener('click', () => {
                alert('Оплата через ЮKassa (рубли) — заглушка.');
            });
            document.getElementById('payUsdt').addEventListener('click', () => {
                alert('Оплата USDT — заглушка. Адрес: TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX');
            });

            console.log('✅ SIGN PAID — космическая кузница, 50 жанров, тестовая попытка');
        })();
    </script>
</body>
</html>
